# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual env
.venv/
venv/
env/

# uv
.uv/

# Trained checkpoints: tracked via Git LFS (see .gitattributes), not ignored.

# Activity 3 keeps results/plots and README local only.
# Checkpoints DO get committed (via LFS for .pth, plain for .joblib) so the
# pipeline can be reproduced with SKIP_TRAINING=1 without retraining.
src/activity3/results/*.png
src/activity3/README.md

# Generated results: keep .png plots in git, ignore noisy timestamped logs.
src/activity*/results/*.log

# Downloaded datasets (heavy, not for git).
# Activity 1 keeps insurance.csv versioned under src/activity1/dataset/.
# Activity 2 uses kagglehub (cached in ~/.cache/kagglehub) and torchvision
# (cached in src/activity2/dataset/cifar10/).
# Activity 3 caches yfinance prices and Kaggle tweets locally.
src/activity2/dataset/
src/activity3/dataset/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local-only artefacts (kept out of the repo on purpose)
scripts/
presentation/
